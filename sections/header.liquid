<!-- <h1> {{ shop.namees }} </h1>-->

{%- liquid 
    assign menu = section.settings.menu 
    -%}
    <nav class="primary-navigation"> 
        <ul class="menu">
            {% for link in menu.links %}
                {% if link.links !=blank %}
                    <li>
                        <details>
                            <summary>
                                {{ link.title }} <span>Icons here</span>
                                </summary>
                            <ul>
                                {% for child in link.links %}
                                    {% if child.links != blank %}
                                    <li> 
                                        <details>
                                            <summary>
                                                {{ child.title }} <span>Icons here</span>
                                            </summary>
                                            <ul>
                                                {% for grandchild in child.links %}
                                                    <li>{{ grandchild.title | link_to: grandchild.url }} </li>
                                                {% endfor %}
                                            </ul>
                                        </details>
                                    </li>
                            </ul>
                        </details>
                    </li>
                    {% else %}
                  <li>{{ child.title | link_to: child.url }} </li>
                    {% endif %}

                <!--  -->
            {% endfor %}
           
        </ul>
    </nav>

    {% schema %}
    {
    "name": "header",
    "tag": "section",
    "settings": [
        {
        "type": "link_list",
        "id": "menu",
        "label": "select menu",
        "default": "main-menu"
    }
                ]
        }
    {% endschema %}