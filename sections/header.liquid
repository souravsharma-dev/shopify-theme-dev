<!-- <h1> {{ shop.namees }} </h1>-->

{%- liquid 
    assign menu = section.settings.menu 
    -%}
    <nav class="primary-navigation"> 
        <ul class="menu">
            {% for link in menu.links %}
                {% if link.links !=blank %}
                    <li>
                        <details>
                            <summary>
                                {{ link.title }} <span>icon</span>
                            <ul>
                                {% for sublink in link.links %}
                            </ul>
                            </summary>
                        </details>
                    </li>
                {% endfor %}

                <!-- <li>{{ link.title | link_to: link.url }} </li> -->
            {% endfor %}
            <li></li>
        </ul>
    </nav>

    {% schema %}
    {
    "name": "header",
    "tag": "section",
    "settings": [
        {
        "type": "link_list",
        "id": "menu",
        "label": "select menu",
        "default": "main-menu"
    }
                ]
        }
    {% endschema %}