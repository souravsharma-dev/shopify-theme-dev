{% schema %}
{
"name": "Hero Banner",
"tag": "section",
"settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id" : "heading_text",
      "label": "Heading Text",
      "default": "Welcome to sourav store"
    },
    {
        "type": "textarea",
        "id" : "subheading_text",
        "label": "Subheading Text",
        "default": "This is a sample subheading text for the hero banner section."
    },
    {
     "type" : "checkbox",
     "id": "full_width",
     "label": "Full Width",
     "default": false
    }
    
],
"presets" :[
    {
        "name": "Hero Banner"
    }
    ]
}
{% endschema %}